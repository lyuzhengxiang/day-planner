# Day Planner — environment template
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored
# (see .gitignore: `.env*`). Never commit your real secrets.
#
# Three integrations are optional but degrade gracefully when keys are absent:
#   - OPENAI_API_KEY missing  → plan generation, goal setup, and reflection fail when invoked
#   - WEATHER_API_KEY missing → weather block shows "Weather unavailable"
#   - RESEND_API_KEY missing  → email fallback is skipped (iMessage still works)

# Required — path to the local SQLite database. Use this exact value unless you
# are intentionally migrating data; see AGENTS.md → "Canonical Local Data".
DATABASE_URL="file:./prisma/dev.db"

# Required for plan generation, goal flow, weekly reflection.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required for the weather snapshot on the daily plan.
# Free tier at https://www.weatherapi.com/ is enough.
WEATHER_API_KEY=

# Optional. Email fallback for daily notifications when iMessage fails.
# https://resend.com/api-keys
RESEND_API_KEY=
